# JAN SAHYOG - local development configuration
# Copy this file to .env and fill in values for your environment.
# Never commit .env or real credentials.

APP_NAME=JAN SAHYOG
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Paths
KNOWLEDGE_SOURCE_DIR=data/source_documents
KNOWLEDGE_PROCESSED_DIR=data/processed
KNOWLEDGE_MANIFEST_PATH=data/processed/manifest.json

# API / CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (optional until persistence is implemented)
DATABASE_URL=

# Vector store (optional starter setting)
VECTOR_STORE=local_json
VECTOR_STORE_PATH=data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM settings. Keep empty until a provider/local server is configured.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Speech services (optional)
STT_PROVIDER=none
TTS_PROVIDER=none
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,mr

# External service integrations (optional; configure only when authorized)
GOVERNMENT_SERVICES_BASE_URL=
MAPS_API_KEY=

# Security: replace before any shared or production deployment
API_KEY=
